<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;App_Data/**;TestResults/**;publish/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup><PackageReference Include="MySqlConnector" Version="2.6.2" /></ItemGroup>
  <ItemGroup><Content Include="database/*.sql" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
